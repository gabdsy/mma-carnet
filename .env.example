# Copie ce fichier en .env et remplis les valeurs (Supabase > Project Settings > API).
# .env n'est jamais commité.

# Envoyées au navigateur (préfixe VITE_) : publiques par conception, protégées par la RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SECRÈTE : uniquement pour scripts/import-content.ts, en local. Jamais de préfixe VITE_.
SUPABASE_SERVICE_ROLE_KEY=
